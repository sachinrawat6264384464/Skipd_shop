# FastAPI Server Environment Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,https://skipd.vercel.app

# Database Configuration (PostgreSQL on Port 5433)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/skipd_commerce_db
# Production PostgreSQL example for Render:
# DATABASE_URL=postgresql+asyncpg://skipd_user:password@dpg-xxxxxx-a.singapore-postgres.render.com/skipd_db

# Security & JWT Token Auth
JWT_SECRET=super_secret_jwt_key_skipd_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Redis & Celery Config
REDIS_URL=redis://localhost:6379/0

# Razorpay Payments Configuration
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Shiprocket Logistics Integration
SHIPROCKET_EMAIL=logistics@skipd.in
SHIPROCKET_PASSWORD=YourShiprocketPassword

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=e-commerse-5db6a
